{
	"name": "CSE 250 Project",
	"build": {
	"dockerfile": "Dockerfile",
	"context": ".."
},
	"features": {
		"ghcr.io/devcontainers/features/git:1": {},
		"ghcr.io/devcontainers/features/github-cli:1.1.3": {},
		"ghcr.io/va-h/devcontainers-features/uv:1": {},
		"ghcr.io/devcontainers/features/node:2.1.1": {},
		"ghcr.io/anthropics/devcontainer-features/claude-code:1.0": {}
	},
	"containerEnv": {
		"DATA_DIR": "${containerWorkspaceFolder}/data",
		"UV_LINK_MODE": "copy"
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"ms-toolsai.jupyter",
				"ms-toolsai.vscode-jupyter-cell-tags",
				"tamasfe.even-better-toml",
				"ms-toolsai.datawrangler",
				"GitHub.vscode-pull-request-github",
				"charliermarsh.ruff",
				"njpwerner.autodocstring",
				"redhat.vscode-yaml",
				"James-Yu.latex-workshop",
				"tomoki1207.pdf"
			],
			"settings": {
				"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
				"jupyter.notebookFileRoot": "${fileDirname}"
			}
		}
	},
	"remoteUser": "vscode",
	// "initializeCommand": "touch .devcontainer/.env",
	"postCreateCommand": "uv sync --locked && uv run nbstripout --install --attributes .gitattributes"
	// "runArgs": ["--env-file", ".devcontainer/.env"]
}